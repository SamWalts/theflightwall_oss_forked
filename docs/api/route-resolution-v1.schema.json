{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flightwall:schema:route-resolution:1",
  "title": "Implemented FlightWall diagnostic route resolution — M1 producer schema",
  "type": "object",
  "properties": {
    "callsign_received": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16
        },
        {
          "type": "null"
        }
      ]
    },
    "normalized_callsign": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 7,
          "pattern": "^(?:[A-Z]{2,3}|[A-Z][0-9]|[0-9][A-Z])(?:[0-9]{1,4}|[0-9]{1,3}[A-Z]|[0-9]{1,2}[A-Z]{2})(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "route_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "airport_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 4,
                "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
              },
              "minItems": 2,
              "maxItems": 128
            },
            "airports": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 4,
                        "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 96
                      },
                      "name_truncated": {
                        "type": "boolean"
                      },
                      "icao": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 4,
                            "maxLength": 4,
                            "pattern": "^[A-Z0-9]{4}(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "iata": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 3,
                            "pattern": "^[A-Z0-9]{3}(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "latitude": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "longitude": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "name_truncated",
                      "icao",
                      "iata",
                      "latitude",
                      "longitude"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2,
                  "maxItems": 8
                },
                {
                  "type": "null"
                }
              ]
            },
            "airport_details_omitted": {
              "type": "boolean"
            },
            "departure_airport": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4,
                  "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "destination_airport": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4,
                  "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_leg_ambiguous": {
              "type": "boolean"
            },
            "kind": {
              "const": "reference"
            },
            "source": {
              "const": "vrs_standing_data"
            },
            "matched_callsign": {
              "type": "string",
              "minLength": 3,
              "maxLength": 7,
              "pattern": "^(?:[A-Z]{2,3}|[A-Z][0-9]|[0-9][A-Z])(?:[0-9]{1,4}|[0-9]{1,3}[A-Z]|[0-9]{1,2}[A-Z]{2})(?![\\s\\S])"
            },
            "dataset_revision": {
              "type": "string",
              "minLength": 40,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time",
              "maxLength": 32,
              "pattern": "Z(?![\\s\\S])"
            },
            "dataset_age_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "flight_instance_verified": {
              "const": false
            }
          },
          "required": [
            "airport_codes",
            "airports",
            "airport_details_omitted",
            "departure_airport",
            "destination_airport",
            "current_leg_ambiguous",
            "kind",
            "source",
            "matched_callsign",
            "dataset_revision",
            "retrieved_at",
            "dataset_age_seconds",
            "flight_instance_verified"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "route_override": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "airport_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 4,
                "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
              },
              "minItems": 2,
              "maxItems": 128
            },
            "airports": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 4,
                        "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 96
                      },
                      "name_truncated": {
                        "type": "boolean"
                      },
                      "icao": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 4,
                            "maxLength": 4,
                            "pattern": "^[A-Z0-9]{4}(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "iata": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 3,
                            "pattern": "^[A-Z0-9]{3}(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "latitude": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "longitude": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "name_truncated",
                      "icao",
                      "iata",
                      "latitude",
                      "longitude"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2,
                  "maxItems": 8
                },
                {
                  "type": "null"
                }
              ]
            },
            "airport_details_omitted": {
              "type": "boolean"
            },
            "departure_airport": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4,
                  "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "destination_airport": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 4,
                  "pattern": "^[A-Z0-9]{3,4}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_leg_ambiguous": {
              "type": "boolean"
            },
            "kind": {
              "const": "dated_override"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "matched_callsign": {
              "type": "string",
              "minLength": 3,
              "maxLength": 7,
              "pattern": "^(?:[A-Z]{2,3}|[A-Z][0-9]|[0-9][A-Z])(?:[0-9]{1,4}|[0-9]{1,3}[A-Z]|[0-9]{1,2}[A-Z]{2})(?![\\s\\S])"
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "flight_date": {
              "type": "string",
              "format": "date",
              "minLength": 10,
              "maxLength": 10
            },
            "valid_from": {
              "type": "string",
              "format": "date-time",
              "maxLength": 32,
              "pattern": "Z(?![\\s\\S])"
            },
            "valid_until": {
              "type": "string",
              "format": "date-time",
              "maxLength": 32,
              "pattern": "Z(?![\\s\\S])"
            },
            "aircraft_hex": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^[A-F0-9]{6}(?![\\s\\S])"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flight_instance_verified": {
              "type": "boolean"
            }
          },
          "required": [
            "airport_codes",
            "airports",
            "airport_details_omitted",
            "departure_airport",
            "destination_airport",
            "current_leg_ambiguous",
            "kind",
            "source",
            "matched_callsign",
            "evidence",
            "flight_date",
            "valid_from",
            "valid_until",
            "aircraft_hex",
            "flight_instance_verified"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "preferred_route": {
      "anyOf": [
        {
          "enum": [
            "route_reference",
            "route_override"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "enum": [
        "reference_missing",
        "reference_invalid",
        "invalid_or_registration_callsign",
        "unknown_airline_prefix",
        "ambiguous_airline_alias",
        "no_route_match",
        "reference_match",
        "route_geography_rejected",
        "missing_airport_reference",
        "dated_override_match"
      ]
    },
    "geography_check": {
      "enum": [
        "not_checked",
        "plausible",
        "rejected",
        "unknown_airport_coordinates"
      ]
    },
    "override_status": {
      "const": "invalid"
    }
  },
  "required": [
    "callsign_received",
    "normalized_callsign",
    "route_reference",
    "route_override",
    "preferred_route",
    "reason",
    "geography_check"
  ],
  "additionalProperties": false
}
